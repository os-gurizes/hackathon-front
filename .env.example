# Copie para .env.local e ajuste.

# true: usa os dados de exemplo de src/api/mocks (não precisa da API rodando)
VITE_API_MOCK=true

# Para onde o Vite repassa /api em dev (API rodando local ou na rede)
VITE_API_PROXY=http://localhost:3333

# Só em produção, se a API estiver em outro endereço (padrão: /api)
# VITE_API_URL=https://api.exemplo.com
